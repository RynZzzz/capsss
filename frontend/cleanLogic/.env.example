# ─────────────────────────────────────────────────────────────────────────────
# CleanLogic Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development.
# On DigitalOcean App Platform, VITE_GOOGLE_CLIENT_ID is set as a build arg
# in .do/app.yaml (it gets baked into the JS bundle at build time).
#
# All client-exposed vars MUST be prefixed with VITE_ — that's how Vite
# decides what to include in the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Base URL (build-time) ────────────────────────────────────────────────
# Base URL for backend API calls. Leave empty when the frontend is served by
# the same origin as the backend (production Docker image). Set to the backend
# URL only when running the frontend dev server separately.
VITE_API_BASE_URL=

# ── Google OAuth Client ID (build-time, REQUIRED for Google sign-in) ─────────
# This is the *web application* client ID from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=191625527569-l6ereqd4ga4o4h5l4t5vr685nri9l2hj.apps.googleusercontent.com
