# ─────────────────────────────────────────────────────────────────────────────
# CleanLogic Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development.
# On DigitalOcean App Platform, set these in .do/app.yaml or the Console.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED in production) ────────────────────────────────────────
# Full SQLAlchemy connection URL. App Platform injects this automatically from
# the attached managed database component (${db.DATABASE_URL}).
# Local dev: leave unset to fall back to SQLite at /tmp/cleanlogic.db.
# DATABASE_URL=mysql+pymysql://user:password@host:25060/cleanlogic?ssl-mode=REQUIRED

# Legacy per-field DB config (only used by DatabaseConfig dataclass; ignored
# when DATABASE_URL is set):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=cleanLogic

# ── CORS (REQUIRED in production) ───────────────────────────────────────────
# Comma-separated list of allowed origins. On App Platform use ${APP_URL}.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI / LLM Keys (at least one recommended) ────────────────────────────────
# Groq — primary text + vision provider (fast inference).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter — fallback text + vision provider.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TEXT_MODEL=openrouter/auto
# OPENROUTER_VISION_MODEL=openrouter/auto
# OPENROUTER_HTTP_REFERER=https://yourapp.com
# OPENROUTER_X_TITLE=CleanLogic

# Ollama — local LLM (no key needed, just the base URL).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi4-mini

# AI_PRIMARY_PROVIDER controls which provider is tried first.
# Options: "groq" (default), "openrouter", "ollama"
# AI_PRIMARY_PROVIDER=groq

# ── Google OAuth (REQUIRED for Google sign-in) ───────────────────────────────
# Server-side client ID used to verify Google ID tokens.
GOOGLE_CLIENT_ID=191625527569-l6ereqd4ga4o4h5l4t5vr685nri9l2hj.apps.googleusercontent.com

# ── Server ───────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ── File handling ────────────────────────────────────────────────────────────
# MAX_FILE_SIZE defaults to 200 MiB. Override if needed (value in bytes).
# MAX_FILE_SIZE=209715200

# Path to the built frontend assets (set automatically in Docker image).
# FRONTEND_DIST=/app/frontend_dist
